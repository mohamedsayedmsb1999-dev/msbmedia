{
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:vercel",
  "outputDirectory": "dist/public",
  "rewrites": [],
  "redirects": [
    {
      "source": "/smm",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/social-growth",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/social-growth/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/social-growth-media.html",
      "destination": "/",
      "permanent": true
    }
  ]
}
