{
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:vercel",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/",
      "destination": "/social-growth-media.html"
    },
    {
      "source": "/smm",
      "destination": "/social-growth-media.html"
    },
    {
      "source": "/social-growth",
      "destination": "/social-growth-media.html"
    },
    {
      "source": "/social-growth/",
      "destination": "/social-growth-media.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
